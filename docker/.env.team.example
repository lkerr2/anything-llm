SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"
UID='1000'
GID='1000'

###########################################
######## TEAM/MULTI-USER SETUP ###########
###########################################
# Enable multi-user mode with authentication
AUTH_TOKEN="your-secure-admin-password-here"
JWT_SECRET="your-random-jwt-secret-key-32-chars-long"
JWT_EXPIRY="30d"

###########################################
######## LLM API SELECTION ################
###########################################
# Example Anthropic setup for teams
LLM_PROVIDER='anthropic'
ANTHROPIC_API_KEY='sk-ant-your-api-key-here'
ANTHROPIC_MODEL_PREF='claude-3-5-sonnet-20241022'

###########################################
######## EMBEDDING SELECTION ##############
###########################################
# Use native embeddings for privacy
EMBEDDING_ENGINE='native'
EMBEDDING_MODEL_PREF='Xenova/all-MiniLM-L6-v2'

###########################################
######## VECTOR DATABASE ##################
###########################################
# Use LanceDB for simplicity
VECTOR_DB="lancedb"

###########################################
######## ADDITIONAL TEAM CONFIG ###########
###########################################
# Optional: Set password complexity requirements
PASSWORDMINCHAR=8
PASSWORDLOWERCASE=1
PASSWORDUPPERCASE=1
PASSWORDNUMERIC=1

# Optional: Enable HTTPS for production
# ENABLE_HTTPS="true"
# HTTPS_CERT_PATH="sslcert/cert.pem"
# HTTPS_KEY_PATH="sslcert/key.pem"